{
  "name": "@grgmddn/prettier-plugin-velocity-html",
  "version": "1.0.0",
  "author": {
    "name": "George Madden",
    "url": "https://github.com/grgmddn"
  },
  "contributors": [
    {
      "name": "Frederik Claus",
      "email": "f.v.claus@googlemail.com"
    }
  ],
  "description": "Prettier 3 plugin for formatting HTML containing Velocity code",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "velocity"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node -e \"require('fs').rmSync('src/parser/generated',{recursive:true,force:true})\" && antlr-ng -Dlanguage=TypeScript --exact-output-dir -o src/parser/generated src/parser/VelocityHtmlLexer.g4",
    "build": "npm run generate && tsdown",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "oxlint src",
    "lint:test": "oxlint test",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify": "npm run format:check && npm run lint && npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grgmddn/prettier-plugin-velocity-html.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/grgmddn/prettier-plugin-velocity-html/issues"
  },
  "homepage": "https://github.com/grgmddn/prettier-plugin-velocity-html#readme",
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "antlr-ng": "^1.0.10",
    "antlr4ng": "^3.0.16",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
