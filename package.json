{
  "name": "@grgmddn/prettier-plugin-velocity-html",
  "version": "1.0.0",
  "author": "",
  "contributors": [
    {
      "name": "Frederik Claus",
      "email": "f.v.claus@googlemail.com"
    }
  ],
  "description": "Prettier plugin for formatting HTML containing Velocity code",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "velocity"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node -e \"require('fs').rmSync('src/parser/generated',{recursive:true,force:true})\" && antlr-ng -Dlanguage=TypeScript --exact-output-dir -o src/parser/generated src/parser/VelocityHtmlLexer.g4",
    "build": "npm run generate && tsdown",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grgmddn/prettier-plugin-velocity-html.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/grgmddn/prettier-plugin-velocity-html/issues"
  },
  "homepage": "https://github.com/grgmddn/prettier-plugin-velocity-html#readme",
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@typescript/typescript6": "^6.0.2",
    "antlr-ng": "^1.0.10",
    "antlr4ng": "^3.0.16",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
